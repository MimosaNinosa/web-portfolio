<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="robots" content="noindex">
{%- if redirectTo %}
<meta http-equiv="refresh" content="0; url={{ redirectTo }}">
<link rel="canonical" href="{{ siteUrl }}{{ redirectTo }}">
{%- endif %}
<title>Moved — Lee Chun Yong</title>
<script src="/js/legacy-redirect.js" defer></script>
</head>
<body data-fallback="{{ fallback or redirectTo }}" data-redirects="{{ redirects | dump }}">
<p>This page has moved. <a href="{{ fallback or redirectTo }}">Continue →</a></p>
</body>
</html>
